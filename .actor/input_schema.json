{
    "$schema": "https://apify.com/schemas/v1/input.ide.json",
    "title": "CheerioCrawler Template",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "searchQuery": {
            "title": "Término de búsqueda",
            "type": "string",
            "description": "Lo que se busca (ej: 06, 海豹, 特斯拉...)",
            "default": "06",
            "editor": "textfield"
        },
        "maxPages": {
            "title": "Máximo de páginas",
            "type": "integer",
            "description": "Cuántas páginas quieres scrapear",
            "default": 1,
            "minimum": 1,
            "maximum": 50
        },
        "maxRequestsPerCrawl": {
            "title": "Máximo de requests",
            "description": "Máximo de requests",
            "type": "integer",
            "default": 50
        }
    }
}
